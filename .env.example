# Copy to .env for local development. Replace the placeholders before startup.
SPRING_PROFILES_ACTIVE=tl-local
TL_DB_URL=jdbc:mysql://127.0.0.1:3306/tl?characterEncoding=utf8&useUnicode=true&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
TL_DB_USER=tl
TL_DB_PASSWORD=change-me
TL_REDIS_HOST=127.0.0.1
TL_REDIS_PORT=6379
TL_REDIS_PASSWORD=
TL_REDIS_DATABASE=10
TL_IMAGE_PATH=./backend/crmebimage/
TL_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
TL_DRUID_MONITOR_ENABLED=false
TL_MESSAGE_SEND_LIMIT=12
TL_MESSAGE_SEND_WINDOW_SECONDS=60
TL_MESSAGE_REPORT_LIMIT=5
TL_MESSAGE_REPORT_WINDOW_SECONDS=3600
